{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "What the Earshot window may do",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "dialog:allow-save",
    "opener:default",
    {
      "identifier": "http:default",
      "allow": [
        { "url": "https://api.deezer.com/*" },
        { "url": "https://link.deezer.com/*" },
        { "url": "https://deezer.page.link/*" },
        { "url": "https://dzr.page.link/*" }
      ]
    }
  ]
}
